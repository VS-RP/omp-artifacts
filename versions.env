# Upstream refs the published images are built from.
#
# Both workflows read this file, so bumping a version here is the whole change
# needed to cut a new image. Pin to something immutable: a commit SHA or a
# release tag, never a branch name.

# openmultiplayer/open.mp — built from source.
# Upstream releases only ship linux-x86 and the newest is months behind master,
# so we track a master commit instead. This one carries the "no components
# loaded" crash fix and the NPC_SetAngleToPos axis fix.
OPENMP_REF=91a38854f02b05f35bcd3d1162d4fc205d9a4cb9

# aurora-mp/omp-cef — repackaged, not built. Their CI already publishes a
# release asset containing the x64 Linux Cef.so, so building CEF from source
# here would only reproduce it slowly.
OMPCEF_TAG=v1.3.0
